+    private int readPageFlipFps() {
+        String out = exec("service call SurfaceFlinger 1013");
+        long count = parsePageFlipCount(out);
+        long now = android.os.SystemClock.elapsedRealtime();
+        if (count < 0L) {
+            // No borramos el valor previo por un fallo transitorio; así una siguiente
+            // lectura válida todavía puede calcular el delta.
+            return -1;
+        }
+
+        long previousCount;
+        long previousAt;
+        synchronized (this) {
+            previousCount = lastPageFlipCount;
+            previousAt = lastPageFlipAtMs;
+            lastPageFlipCount = count;
+            lastPageFlipAtMs = now;
+        }
+        if (previousCount < 0L || previousAt <= 0L || now <= previousAt) {
+            lastStatus = "FPS preparando contador SurfaceFlinger" + shellSuffix();
+            lastLayer = "SurfaceFlinger 1013";
+            return -1;
+        }
+
+        long delta;
+        if (count >= previousCount) {
+            delta = count - previousCount;
+        } else {
+            // El contador es int32 y puede hacer wrap.
+            delta = (0x1_0000_0000L - previousCount) + count;
+        }
