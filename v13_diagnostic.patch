+    private static String outputSummary(String s) {
+        if (s == null || s.trim().isEmpty()) return "VACÍO";
+        String low = s.toLowerCase(Locale.ROOT);
+        if (low.contains("permission denied") || low.contains("not permitted") || low.contains("securityexception")) {
+            return "DENEGADO:" + compact(s, 88);
+        }
+        if (low.contains("unknown transaction") || low.contains("unknown option") || low.contains("not found")) {
+            return "NO-SOPORTADO:" + compact(s, 88);
+        }
+        int lines = 0;
+        for (String line : s.split("\r?\n")) if (line != null && !line.trim().isEmpty()) lines++;
+        return "OK chars=" + s.length() + " lines=" + lines + " raw=" + compact(s, 88);
+    }
+
+    private static String compact(String s, int max) {
+        if (s == null) return "—";
+        String t = s.replace('\r', ' ').replace('\n', ' ').replaceAll("\\s+", " ").trim();
+        if (t.isEmpty()) return "VACÍO";
+        if (t.length() > max) return t.substring(0, Math.max(1, max - 1)) + "…";
+        return t;
+    }
+
